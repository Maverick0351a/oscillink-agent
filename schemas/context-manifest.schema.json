{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/context-manifest.schema.json",
  "title": "Oscillink Agent Context Manifest",
  "$comment": "Structural validation only. Pydantic enforces exact token summation, budget relationships, and included/omitted disjointness; trusted compilation resolves referenced records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "task_id",
    "compiled_at",
    "token_budget",
    "total_token_count",
    "policy_hash",
    "items"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^ctx_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"},
    "compiled_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "token_budget": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "total_token_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "policy_hash": {"$ref": "#/$defs/digest"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"},
      "uniqueItems": true
    },
    "omissions": {
      "type": "array",
      "items": {"$ref": "#/$defs/omission"}
    },
    "exclusion_summary": {"$ref": "#/$defs/exclusion_summary"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^(evt|clm|doc|mem|prc)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nullable_positive_integer": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "content_hash",
        "inclusion_reason",
        "trust_class",
        "status",
        "token_count",
        "source_refs"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/record_id"},
        "content_hash": {"$ref": "#/$defs/digest"},
        "inclusion_reason": {"type": "string", "minLength": 1},
        "trust_class": {
          "enum": [
            "human_verified",
            "tool_verified",
            "model_generated",
            "external_untrusted",
            "system"
          ]
        },
        "status": {"enum": ["approved", "contested", "superseded", "retracted"]},
        "token_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "source_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/record_id"},
          "uniqueItems": true,
          "minItems": 1
        },
        "retrieval_rank": {"$ref": "#/$defs/nullable_positive_integer"},
        "retrieval_score": {"$ref": "#/$defs/nullable_positive_integer"}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "content_hash",
        "reason",
        "retrieval_rank",
        "retrieval_score"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/record_id"},
        "content_hash": {"$ref": "#/$defs/digest"},
        "reason": {"enum": ["token_budget", "no_query_match"]},
        "retrieval_rank": {"$ref": "#/$defs/nullable_positive_integer"},
        "retrieval_score": {"$ref": "#/$defs/nullable_positive_integer"}
      }
    },
    "exclusion_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_approved_count",
        "missing_source_count",
        "superseded_count",
        "conflict_count"
      ],
      "properties": {
        "not_approved_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "missing_source_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "superseded_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "conflict_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
