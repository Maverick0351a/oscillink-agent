{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/memory-claim.schema.json",
  "title": "Oscillink Agent Memory Claim",
  "$comment": "Structural validation only. Pydantic enforces temporal/hash/self-support semantics; trusted storage must authenticate review_event_id before canonical promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "epistemic_class",
    "status",
    "subject_id",
    "content",
    "valid_from",
    "valid_until",
    "recorded_at",
    "source_refs",
    "content_hash",
    "asserted_by",
    "review_state",
    "review_event_id",
    "sensitivity"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "epistemic_class": {
      "enum": [
        "user_assertion",
        "tool_observation",
        "external_source",
        "model_inference",
        "hypothesis",
        "decision",
        "preference",
        "policy"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "supported",
        "disputed",
        "contradicted",
        "retracted",
        "superseded"
      ]
    },
    "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "content": {"type": "string", "minLength": 1},
    "valid_from": {
      "anyOf": [
        {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
        {"type": "null"}
      ]
    },
    "valid_until": {
      "anyOf": [
        {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
        {"type": "null"}
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(evt|clm|doc|prc)_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "content_hash": {"$ref": "#/$defs/digest"},
    "asserted_by": {
      "type": "string",
      "pattern": "^(human|model|tool|system)_[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "review_state": {"enum": ["unreviewed", "approved", "rejected"]},
    "review_event_id": {
      "anyOf": [
        {"type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"},
        {"type": "null"}
      ]
    },
    "sensitivity": {"enum": ["public", "internal", "private", "restricted"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"review_state": {"const": "unreviewed"}},
        "required": ["review_state"]
      },
      "then": {"properties": {"review_event_id": {"type": "null"}}},
      "else": {
        "properties": {
          "review_event_id": {
            "type": "string",
            "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
