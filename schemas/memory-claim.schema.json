{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/memory-claim.schema.json",
  "title": "Oscillink Agent Memory Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "epistemic_class",
    "status",
    "subject_id",
    "content",
    "valid_from",
    "valid_until",
    "recorded_at",
    "source_refs",
    "content_hash",
    "asserted_by",
    "review_state",
    "sensitivity"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "epistemic_class": {
      "enum": [
        "user_assertion",
        "tool_observation",
        "external_source",
        "model_inference",
        "hypothesis",
        "decision",
        "preference",
        "policy"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "supported",
        "disputed",
        "contradicted",
        "retracted",
        "superseded"
      ]
    },
    "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "content": {"type": "string", "minLength": 1},
    "valid_from": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "valid_until": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(evt|clm|doc|prc)_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "content_hash": {"$ref": "#/$defs/digest"},
    "asserted_by": {
      "type": "string",
      "pattern": "^(human|model|tool|system)_[a-z0-9][a-z0-9_-]{1,62}$"
    },
    "review_state": {"enum": ["unreviewed", "approved", "rejected"]},
    "sensitivity": {"enum": ["public", "internal", "private", "restricted"]}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
