{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/event.schema.json",
  "title": "Oscillink Agent Event",
  "$comment": "Structural validation only. Pydantic and trusted ledger ingress enforce chronology, hash equality, self-causality, and referenced-record existence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "session_id",
    "run_id",
    "task_id",
    "actor",
    "event_type",
    "observed_at",
    "recorded_at",
    "payload_hash",
    "artifact_refs",
    "causal_parent_ids",
    "trust_class",
    "sensitivity",
    "payload"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^ses_[0-9A-HJKMNP-TV-Z]{26}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"},
    "task_id": {"type": "string", "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(human|model|tool|system)_[a-z0-9][a-z0-9_-]{1,62}$"
        },
        "type": {"enum": ["human", "model", "tool", "system"]}
      },
      "oneOf": [
        {
          "properties": {
            "id": {"pattern": "^human_[a-z0-9][a-z0-9_-]{1,62}$"},
            "type": {"const": "human"}
          }
        },
        {
          "properties": {
            "id": {"pattern": "^model_[a-z0-9][a-z0-9_-]{1,62}$"},
            "type": {"const": "model"}
          }
        },
        {
          "properties": {
            "id": {"pattern": "^tool_[a-z0-9][a-z0-9_-]{1,62}$"},
            "type": {"const": "tool"}
          }
        },
        {
          "properties": {
            "id": {"pattern": "^system_[a-z0-9][a-z0-9_-]{1,62}$"},
            "type": {"const": "system"}
          }
        }
      ]
    },
    "event_type": {
      "enum": [
        "message",
        "model_call",
        "tool_call",
        "observation",
        "memory_proposal",
        "approval",
        "correction",
        "retraction",
        "outcome"
      ]
    },
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "payload_hash": {"$ref": "#/$defs/digest"},
    "artifact_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/digest"},
      "uniqueItems": true
    },
    "causal_parent_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"},
      "uniqueItems": true
    },
    "trust_class": {
      "enum": [
        "human_verified",
        "tool_verified",
        "model_generated",
        "external_untrusted",
        "system"
      ]
    },
    "sensitivity": {"enum": ["public", "internal", "private", "restricted"]},
    "payload": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"maxLength": 128},
      "additionalProperties": {"$ref": "#/$defs/json_value"}
    },
    "model": {
      "anyOf": [
        {"$ref": "#/$defs/model_identity"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"const": "model_call"}},
        "required": ["event_type"]
      },
      "then": {
        "required": ["model"],
        "properties": {"model": {"$ref": "#/$defs/model_identity"}}
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {"type": {"const": "model"}},
            "required": ["type"]
          }
        },
        "required": ["actor"]
      },
      "then": {
        "required": ["model"],
        "properties": {
          "model": {"$ref": "#/$defs/model_identity"},
          "trust_class": {"const": "model_generated"}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {"event_type": {"not": {"const": "model_call"}}},
            "required": ["event_type"]
          },
          {
            "properties": {
              "actor": {
                "properties": {"type": {"not": {"const": "model"}}},
                "required": ["type"]
              }
            },
            "required": ["actor"]
          }
        ]
      },
      "then": {"properties": {"model": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {"type": {"const": "human"}},
            "required": ["type"]
          }
        },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "trust_class": {"enum": ["human_verified", "external_untrusted"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {"type": {"const": "tool"}},
            "required": ["type"]
          }
        },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "trust_class": {"enum": ["tool_verified", "external_untrusted"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {"type": {"const": "system"}},
            "required": ["type"]
          }
        },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "trust_class": {"enum": ["system", "external_untrusted"]}
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "json_value": {
      "anyOf": [
        {"$ref": "#/$defs/json_scalar"},
        {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/json_value_level_2"}
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/json_value_level_2"}
        }
      ]
    },
    "json_value_level_2": {
      "anyOf": [
        {"$ref": "#/$defs/json_scalar"},
        {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/json_scalar"}
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"maxLength": 128},
          "additionalProperties": {"$ref": "#/$defs/json_scalar"}
        }
      ]
    },
    "json_scalar": {
      "anyOf": [
        {"type": "string", "maxLength": 16384},
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "configuration_hash"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        },
        "configuration_hash": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
