{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/benchmark-manifest.schema.json",
  "title": "Oscillink Agent Benchmark Manifest",
  "$comment": "A complete test declaration is not evidence of execution; external evaluation records must establish that the benchmark ran and passed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "name",
    "version",
    "created_at",
    "task_set_hash",
    "hidden_labels",
    "conditions",
    "metrics",
    "budgets",
    "promotion_gate",
    "threat_cases"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^bmk_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "task_set_hash": {"$ref": "#/$defs/digest"},
    "hidden_labels": {"const": "external"},
    "conditions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_memory",
          "raw_transcript",
          "hand_markdown",
          "generated_summary",
          "fts5_evidence",
          "provenance_evidence"
        ]
      },
      "allOf": [
        {"contains": {"const": "no_memory"}},
        {"contains": {"const": "raw_transcript"}},
        {"contains": {"const": "hand_markdown"}},
        {"contains": {"const": "generated_summary"}},
        {"contains": {"const": "fts5_evidence"}},
        {"contains": {"const": "provenance_evidence"}}
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "citation_precision",
        "evidence_recall",
        "temporal_accuracy",
        "obsolete_memory_reuse",
        "contradiction_detection",
        "abstention",
        "unsafe_instruction_following",
        "latency",
        "tokens",
        "correction_burden",
        "critical_provenance_failures"
      ],
      "properties": {
        "correctness": {"const": "maximize"},
        "citation_precision": {"const": "maximize"},
        "evidence_recall": {"const": "maximize"},
        "temporal_accuracy": {"const": "maximize"},
        "obsolete_memory_reuse": {"const": "minimize"},
        "contradiction_detection": {"const": "maximize"},
        "abstention": {"const": "maximize"},
        "unsafe_instruction_following": {"const": "minimize"},
        "latency": {"const": "minimize"},
        "tokens": {"const": "minimize"},
        "correction_burden": {"const": "minimize"},
        "critical_provenance_failures": {"const": "minimize"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_seconds", "max_tool_calls", "max_retries"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_critical_failures",
        "require_equal_budgets",
        "require_external_verification"
      ],
      "properties": {
        "max_critical_failures": {"const": 0},
        "require_equal_budgets": {"const": true},
        "require_external_verification": {"const": true}
      }
    },
    "threat_cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "memory_poisoning",
          "stale_state",
          "permission_escalation",
          "cross_scope_retrieval",
          "unsupported_completion",
          "secret_exposure",
          "contradiction_handling",
          "provenance_omission"
        ]
      },
      "allOf": [
        {"contains": {"const": "memory_poisoning"}},
        {"contains": {"const": "stale_state"}},
        {"contains": {"const": "permission_escalation"}},
        {"contains": {"const": "cross_scope_retrieval"}},
        {"contains": {"const": "unsupported_completion"}},
        {"contains": {"const": "secret_exposure"}},
        {"contains": {"const": "contradiction_handling"}},
        {"contains": {"const": "provenance_omission"}}
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
