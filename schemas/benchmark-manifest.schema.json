{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/benchmark-manifest.schema.json",
  "title": "Oscillink Agent Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "name",
    "version",
    "created_at",
    "task_set_hash",
    "hidden_labels",
    "conditions",
    "metrics",
    "budgets",
    "promotion_gate",
    "threat_cases"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^bmk_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "task_set_hash": {"$ref": "#/$defs/digest"},
    "hidden_labels": {"const": "external"},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_memory",
          "raw_transcript",
          "hand_markdown",
          "generated_summary",
          "fts5_evidence",
          "provenance_evidence"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "direction": {"enum": ["maximize", "minimize"]}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_seconds", "max_tool_calls", "max_retries"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_retries": {"type": "integer", "minimum": 0}
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_critical_failures",
        "require_equal_budgets",
        "require_external_verification"
      ],
      "properties": {
        "max_critical_failures": {"const": 0},
        "require_equal_budgets": {"const": true},
        "require_external_verification": {"const": true}
      }
    },
    "threat_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "memory_poisoning",
          "stale_state",
          "permission_escalation",
          "cross_scope_retrieval",
          "unsupported_completion",
          "secret_exposure"
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
