{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oscillink.com/schemas/agent/capability-grant.schema.json",
  "title": "Oscillink Agent Capability Grant",
  "$comment": "This non-authoritative record does not confer access. A trusted broker must authenticate issuance, resolve scope, bind the ledger event, and consume use atomically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "subject_actor_id",
    "capability",
    "resource",
    "issued_at",
    "valid_for_seconds",
    "issued_by",
    "authorization_event_id",
    "max_uses",
    "constraints"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$"},
    "schema_version": {"const": 1},
    "subject_actor_id": {"type": "string", "pattern": "^(human|model|tool|system)_[a-z0-9][a-z0-9_-]{1,62}$"},
    "capability": {"const": "file.read"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "target"],
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$",
          "maxLength": 4096,
          "not": {
            "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"
          }
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "valid_for_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "issued_by": {"type": "string", "pattern": "^(human|model|tool|system)_[a-z0-9][a-z0-9_-]{1,62}$"},
    "authorization_event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "max_uses": {"const": 1},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "allowed_extensions", "network_allowed"],
      "properties": {
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "allowed_extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
        },
        "network_allowed": {"const": false}
      }
    }
  }
}
